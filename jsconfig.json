{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020"],
    "typeRoots": ["./node_modules/@figma"],
    "types": ["plugin-typings"],
    "strict": false
  },
  "include": ["src/main/**/*.js", "src/shared/**/*.js"]
}
